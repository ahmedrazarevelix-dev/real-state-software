# Database Configuration
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Server Configuration
PORT=5001
NODE_ENV=development

# JWT Configuration
ACCESS_TOKEN_SECRET=your_access_token_secret_here
ACCESS_TOKEN_SECRET_EXPIRY=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_SECRET_EXPIRY=7d

# Security
BCRYPT_SALT_ROUNDS=12
OTP_EXPIRY_MINUTES=10

# Email Configuration (Brevo)
BREVO_API_KEY=your_brevo_api_key
BREVO_FROM_EMAIL=your@email.com
BREVO_FROM_NAME=Your Platform Name

# Gmail SMTP (Optional)
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# CORS
CORS_ORIGIN=http://localhost:3000

# Supabase Storage
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_key
SUPABASE_STORAGE_BUCKET=your_bucket_name

# Admin Registration
ALLOW_ADMIN_REGISTRATION=false
SUPER_ADMIN_INVITE_CODE=your_super_admin_code
ADMIN_INVITE_CODE=your_admin_code

# Payment System
AUTO_COMPLETE_PAYMENTS=true
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Payment Settings
PAYMENT_CURRENCY=PKR
MIN_SUCCESS_FEE=10000
MAX_SUCCESS_FEE=50000
PLATFORM_COMMISSION_RATE=3

# Invoice Configuration
INVOICE_PREFIX=INV
COMPANY_NAME=Your Company Name
COMPANY_ADDRESS=Your Address
COMPANY_NTN=1234567890

# Rate Limiting
AUTH_RATE_LIMIT_WINDOW_MS=120000
AUTH_RATE_LIMIT_MAX=10

# Background Jobs
ENABLE_PAYMENT_RECONCILIATION=true
RECONCILIATION_CRON=0 2 * * *
SUBSCRIPTION_RENEWAL_CRON=0 0 * * *
