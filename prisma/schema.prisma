generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String           @id @default(uuid())
  roleName    String           @unique @map("role_name")
  createdAt   DateTime         @default(now()) @map("created_at")
  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id             String           @id @default(uuid())
  permissionName String           @unique @map("permission_name")
  description    String?
  createdAt      DateTime         @default(now()) @map("created_at")
  roles          RolePermission[]

  @@map("permissions")
}

model User {
  id                         String                    @id @default(uuid())
  email                      String                    @unique
  password                   String
  otp                        String?
  phone                      String?
  status                     UserStatus                @default(active)
  isVerified                 Boolean                   @default(false) @map("is_verified")
  resetOtp                   String?                   @map("reset_otp")
  resetOtpExpiry             DateTime?                 @map("reset_otp_expiry")
  refreshToken               String?                   @map("refresh_token")
  createdAt                  DateTime                  @default(now()) @map("created_at")
  updatedAt                  DateTime                  @updatedAt @map("updated_at")
  otpExpiry                  DateTime?                 @map("otp_expiry")
  name                       String
  isProfileComplete          Boolean                   @default(false) @map("is_profile_complete")
  facebookUrl                String?                   @map("facebook_url")
  instagramHandle            String?                   @map("instagram_handle")
  linkedinUrl                String?                   @map("linkedin_url")
  officeAddress              String?                   @map("office_address")
  officeHours                String?                   @map("office_hours")
  officePhone                String?                   @map("office_phone")
  twitterHandle              String?                   @map("twitter_handle")
  websiteUrl                 String?                   @map("website_url")
  whatsappNumber             String?                   @map("whatsapp_number")
  agencyName                 String?                   @map("agency_name")
  subscription               AgentSubscription?        @relation("UserSubscription")
  sellerSubscription         SellerSubscription?       @relation("SellerSubscription")
  managedListings            PropertyListing[]         @relation("ManagedListings")
  agentAgreementsAsSeller    AgentSellerAgreement[]    @relation("SellerAgreements")
  agentAgreementsAsAgent     AgentSellerAgreement[]    @relation("AgentAgreements")
  agentReviews               AgentVerification[]       @relation("AgentVerificationReviewer")
  agentVerification          AgentVerification?        @relation("AgentVerificationApplicant")
  auditLogs                  AuditLog[]                @relation("UserAuditLogs")
  sentMessages               ConversationMessage[]     @relation("MessageSender")
  conversationsAsParticipant ConversationParticipant[]
  conversationsStarted       Conversation[]            @relation("ConversationStarter")
  invoices                   Invoice[]                 @relation("UserInvoices")
  inquiriesSent              ListingInquiry[]          @relation("InquiryBuyer")
  listingLeads               ListingLead[]             @relation("LeadBuyer")
  loginAttempts              LoginAttempt[]            @relation("UserLoginAttempts")
  notificationPref           NotificationPreference?   @relation("UserNotificationPreference")
  notifications              Notification[]            @relation("UserNotifications")
  payments                   Payment[]                 @relation("UserPayments")
  listings                   PropertyListing[]         @relation("ListingOwner")
  listingReviews             PropertyListing[]         @relation("ListingReviewer")
  savedListings              SavedListing[]            @relation("SavedByUser")
  sellerReviews              SellerVerification[]      @relation("SellerVerificationReviewer")
  sellerVerification         SellerVerification?       @relation("SellerVerificationApplicant")
  toursRequested             TourRequest[]             @relation("TourBuyer")
  blocksReceived             UserBlock[]               @relation("Blocked")
  blocksGiven                UserBlock[]               @relation("Blocker")
  rolesAssigned              UserRole[]                @relation("AssignedByUser")
  userRole                   UserRole?                 @relation("UserToUserRole")
  sessions                   UserSession[]             @relation("UserSessions")
  tenantApplications         TenantApplication[]       @relation("TenantApplications")
  reviewedApplications       TenantApplication[]       @relation("ApplicationReviewer")
  tenantLeases               TenantAssignment[]        @relation("TenantLeases")
  assignedTenants            TenantAssignment[]        @relation("AssignedTenants")
  purchaseApplications       PurchaseApplication[]     @relation("PurchaseApplications")
  reviewedPurchaseApps       PurchaseApplication[]     @relation("PurchaseApplicationReviewer")
  buyerAgreements            PurchaseAgreement[]       @relation("BuyerAgreements")
  sellerAgreements           PurchaseAgreement[]       @relation("SellerAgreements")
  createdAgreements          PurchaseAgreement[]       @relation("CreatedAgreements")

  @@map("users")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  roleId     String   @map("role_id")
  assignedBy String?  @map("assigned_by")
  createdAt  DateTime @default(now()) @map("created_at")
  assigner   User?    @relation("AssignedByUser", fields: [assignedBy], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])
  user       User     @relation("UserToUserRole", fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_roles")
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  deviceInfo String?   @map("device_info")
  isActive   Boolean   @default(true) @map("is_active")
  revokedAt  DateTime? @map("revoked_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("user_sessions")
}

model LoginAttempt {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  email     String?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  success   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation("UserLoginAttempts", fields: [userId], references: [id])

  @@index([email, createdAt])
  @@index([success, createdAt])
  @@map("login_attempts")
}

model Conversation {
  id           String                    @id @default(uuid())
  listingId    String?                   @map("listing_id")
  startedById  String                    @map("started_by")
  subject      String?
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")
  messages     ConversationMessage[]
  participants ConversationParticipant[]
  listing      PropertyListing?          @relation("ListingConversations", fields: [listingId], references: [id])
  startedBy    User                      @relation("ConversationStarter", fields: [startedById], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([updatedAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  userId         String       @map("user_id")
  joinedAt       DateTime     @default(now()) @map("joined_at")
  lastReadAt     DateTime?    @map("last_read_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model ConversationMessage {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  senderId       String       @map("sender_id")
  body           String
  createdAt      DateTime     @default(now()) @map("created_at")
  editedAt       DateTime?    @map("edited_at")
  deletedAt      DateTime?    @map("deleted_at")
  deliveredAt    DateTime?    @map("delivered_at")
  readAt         DateTime?    @map("read_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("conversation_messages")
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model PropertyListing {
  id                String             @id @default(uuid())
  reference         String             @unique
  title             String
  purpose           ListingPurpose
  propertyType      PropertyType       @map("property_type")
  city              String
  location          String
  address           String?
  price             Decimal            @db.Decimal(14, 2)
  currency          String             @default("PKR")
  area              Decimal?           @db.Decimal(12, 2)
  areaUnit          AreaUnit?          @map("area_unit")
  bedrooms          Int?
  bathrooms         Int?
  furnishing        FurnishingStatus?
  description       String?
  amenities         String[]           @default([])
  photos            String[]           @default([])
  latitude          Decimal?           @db.Decimal(10, 7)
  longitude         Decimal?           @db.Decimal(10, 7)
  listedById        String             @map("listed_by")
  managedByAgentId  String?            @map("managed_by_agent_id")
  status            ListingStatus      @default(active)
  viewCount         Int                @default(0) @map("view_count")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  rejectionReason   String?            @map("rejection_reason")
  reviewedAt        DateTime?          @map("reviewed_at")
  reviewedBy        String?            @map("reviewed_by")
  submittedAt       DateTime?          @map("submitted_at")
  conversations     Conversation[]     @relation("ListingConversations")
  inquiries         ListingInquiry[]
  leads             ListingLead[]
  payments          Payment[]          @relation("ListingPayments")
  documents         PropertyDocument[]
  listedBy          User               @relation("ListingOwner", fields: [listedById], references: [id], onDelete: Cascade)
  managedByAgent    User?              @relation("ManagedListings", fields: [managedByAgentId], references: [id], onDelete: SetNull)
  reviewer          User?              @relation("ListingReviewer", fields: [reviewedBy], references: [id])
  savedBy           SavedListing[]
  tours             TourRequest[]
  agentAgreements   AgentSellerAgreement[]
  tenantApplications TenantApplication[] @relation("ListingApplications")
  currentTenants  TenantAssignment[] @relation("PropertyTenants")
  purchaseApplications PurchaseApplication[] @relation("ListingPurchaseApplications")
  purchaseAgreements PurchaseAgreement[] @relation("PropertyPurchaseAgreements")

  @@index([purpose, city, status])
  @@index([listedById])
  @@index([propertyType])
  @@map("property_listings")
}

model SellerVerification {
  id              String                   @id @default(uuid())
  userId          String                   @unique @map("user_id")
  sellerType      SellerType               @map("seller_type")
  status          SellerVerificationStatus @default(draft)
  adminNotes      String?                  @map("admin_notes")
  rejectionReason String?                  @map("rejection_reason")
  reviewedBy      String?                  @map("reviewed_by")
  submittedAt     DateTime?                @map("submitted_at")
  reviewedAt      DateTime?                @map("reviewed_at")
  expiresAt       DateTime?                @map("expires_at")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  reviewer        User?                    @relation("SellerVerificationReviewer", fields: [reviewedBy], references: [id])
  user            User                     @relation("SellerVerificationApplicant", fields: [userId], references: [id], onDelete: Cascade)
  documents       VerificationDocument[]

  @@index([status])
  @@map("seller_verifications")
}

model AgentVerification {
  id               String                      @id @default(uuid())
  userId           String                      @unique @map("user_id")
  agencyName       String                      @map("agency_name")
  licenseNumber    String?                     @map("license_number")
  licenseExpiresAt DateTime?                   @map("license_expires_at")
  status           AgentVerificationStatus     @default(draft)
  adminNotes       String?                     @map("admin_notes")
  rejectionReason  String?                     @map("rejection_reason")
  reviewedBy       String?                     @map("reviewed_by")
  submittedAt      DateTime?                   @map("submitted_at")
  reviewedAt       DateTime?                   @map("reviewed_at")
  expiresAt        DateTime?                   @map("expires_at")
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")
  documents        AgentVerificationDocument[]
  reviewer         User?                       @relation("AgentVerificationReviewer", fields: [reviewedBy], references: [id])
  user             User                        @relation("AgentVerificationApplicant", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("agent_verifications")
}

model AgentVerificationDocument {
  id              String                     @id @default(uuid())
  verificationId  String                     @map("verification_id")
  documentType    AgentDocumentType          @map("document_type")
  fileName        String                     @map("file_name")
  storageKey      String                     @map("storage_key")
  mimeType        String                     @map("mime_type")
  fileSize        Int                        @map("file_size")
  status          VerificationDocumentStatus @default(pending)
  rejectionReason String?                    @map("rejection_reason")
  reviewedAt      DateTime?                  @map("reviewed_at")
  createdAt       DateTime                   @default(now()) @map("created_at")
  verification    AgentVerification          @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@unique([verificationId, documentType])
  @@map("agent_verification_documents")
}

model VerificationDocument {
  id              String                     @id @default(uuid())
  verificationId  String                     @map("verification_id")
  documentType    VerificationDocumentType   @map("document_type")
  fileName        String                     @map("file_name")
  storageKey      String                     @map("storage_key")
  mimeType        String                     @map("mime_type")
  fileSize        Int                        @map("file_size")
  status          VerificationDocumentStatus @default(pending)
  rejectionReason String?                    @map("rejection_reason")
  reviewedAt      DateTime?                  @map("reviewed_at")
  createdAt       DateTime                   @default(now()) @map("created_at")
  verification    SellerVerification         @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@unique([verificationId, documentType])
  @@map("verification_documents")
}

model PropertyDocument {
  id              String                     @id @default(uuid())
  listingId       String                     @map("listing_id")
  documentType    VerificationDocumentType   @map("document_type")
  fileName        String                     @map("file_name")
  storageKey      String                     @map("storage_key")
  mimeType        String                     @map("mime_type")
  fileSize        Int                        @map("file_size")
  status          VerificationDocumentStatus @default(pending)
  rejectionReason String?                    @map("rejection_reason")
  reviewedAt      DateTime?                  @map("reviewed_at")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")
  listing         PropertyListing            @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, documentType])
  @@index([status])
  @@map("property_documents")
}

model ListingInquiry {
  id        String          @id @default(uuid())
  listingId String          @map("listing_id")
  buyerId   String          @map("buyer_id")
  message   String
  phone     String?
  email     String?
  status    InquiryStatus   @default(new)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  buyer     User            @relation("InquiryBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  listing   PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([buyerId])
  @@map("listing_inquiries")
}

model TourRequest {
  id          String          @id @default(uuid())
  listingId   String          @map("listing_id")
  buyerId     String          @map("buyer_id")
  scheduledAt DateTime        @map("scheduled_at")
  notes       String?
  status      TourStatus      @default(requested)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  buyer       User            @relation("TourBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  listing     PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([buyerId])
  @@map("tour_requests")
}

model ListingLead {
  id        String          @id @default(uuid())
  listingId String          @map("listing_id")
  buyerId   String          @map("buyer_id")
  interest  BuyerInterest   @default(inquired)
  agentNote String?         @map("agent_note")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  buyer     User            @relation("LeadBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  listing   PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, buyerId])
  @@index([listingId, interest])
  @@index([buyerId])
  @@map("listing_leads")
}

model SavedListing {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  listingId String          @map("listing_id")
  createdAt DateTime        @default(now()) @map("created_at")
  listing   PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User            @relation("SavedByUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@map("saved_listings")
}

model AuditLog {
  id           String   @id @default(uuid())
  action       String
  endpoint     String?
  entity       String?
  entityId     String?  @map("entity_id")
  errorMessage String?  @map("error_message")
  ipAddress    String?  @map("ip_address")
  metadata     Json?
  method       String?
  newValues    Json?    @map("new_values")
  oldValues    Json?    @map("old_values")
  statusCode   Int?     @map("status_code")
  success      Boolean  @default(true)
  timestamp    DateTime @default(now())
  userAgent    String?  @map("user_agent")
  userId       String?  @map("user_id")
  user         User?    @relation("UserAuditLogs", fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([timestamp])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model Notification {
  id            String               @id @default(uuid())
  userId        String               @map("user_id")
  type          NotificationType
  priority      NotificationPriority @default(MEDIUM)
  status        NotificationStatus   @default(PENDING)
  title         String
  message       String
  category      String
  entityType    String?              @map("entity_type")
  entityId      String?              @map("entity_id")
  actionUrl     String?              @map("action_url")
  actionLabel   String?              @map("action_label")
  sentAt        DateTime?            @map("sent_at")
  readAt        DateTime?            @map("read_at")
  failureReason String?              @map("failure_reason")
  metadata      Json?
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  user          User                 @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  emailEnabled   Boolean  @default(true) @map("email_enabled")
  emailListings  Boolean  @default(true) @map("email_listings")
  emailInquiries Boolean  @default(true) @map("email_inquiries")
  emailTours     Boolean  @default(true) @map("email_tours")
  emailSecurity  Boolean  @default(true) @map("email_security")
  smsEnabled     Boolean  @default(false) @map("sms_enabled")
  smsListings    Boolean  @default(true) @map("sms_listings")
  smsInquiries   Boolean  @default(true) @map("sms_inquiries")
  smsSecurity    Boolean  @default(true) @map("sms_security")
  inAppEnabled   Boolean  @default(true) @map("in_app_enabled")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation("UserNotificationPreference", fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model Payment {
  id                 String                @id @default(uuid())
  userId             String                @map("user_id")
  amount             Decimal               @db.Decimal(12, 2)
  currency           String                @default("PKR")
  provider           PaymentProvider
  paymentType        PaymentType           @map("payment_type")
  status             PaymentStatus         @default(pending)
  providerPaymentId  String?               @map("provider_payment_id")
  providerCustomerId String?               @map("provider_customer_id")
  idempotencyKey     String                @unique @map("idempotency_key")
  description        String?
  metadata           Json?
  refundedAmount     Decimal?              @map("refunded_amount") @db.Decimal(12, 2)
  refundReason       String?               @map("refund_reason")
  commissionRate     Decimal?              @map("commission_rate") @db.Decimal(5, 2)
  agentCommission    Decimal?              @map("agent_commission") @db.Decimal(12, 2)
  platformFee        Decimal?              @map("platform_fee") @db.Decimal(12, 2)
  relatedListingId   String?               @map("related_listing_id")
  relatedInquiryId   String?               @map("related_inquiry_id")
  paidAt             DateTime?             @map("paid_at")
  refundedAt         DateTime?             @map("refunded_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  invoice            Invoice?              @relation("PaymentInvoice")
  webhookEvents      PaymentWebhookEvent[] @relation("PaymentEvents")
  relatedListing     PropertyListing?      @relation("ListingPayments", fields: [relatedListingId], references: [id])
  user               User                  @relation("UserPayments", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([paymentType])
  @@index([provider, providerPaymentId])
  @@index([createdAt])
  @@map("payments")
}

model PaymentWebhookEvent {
  id          String          @id @default(uuid())
  paymentId   String?         @map("payment_id")
  provider    PaymentProvider
  eventId     String          @unique @map("event_id")
  eventType   String          @map("event_type")
  processed   Boolean         @default(false)
  processedAt DateTime?       @map("processed_at")
  attempts    Int             @default(0)
  lastError   String?         @map("last_error")
  rawPayload  Json            @map("raw_payload")
  createdAt   DateTime        @default(now()) @map("created_at")
  payment     Payment?        @relation("PaymentEvents", fields: [paymentId], references: [id])

  @@index([eventId])
  @@index([processed])
  @@index([createdAt])
  @@map("payment_webhook_events")
}

model Invoice {
  id            String        @id @default(uuid())
  paymentId     String        @unique @map("payment_id")
  userId        String        @map("user_id")
  invoiceNumber String        @unique @map("invoice_number")
  subtotal      Decimal       @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  currency      String        @default("PKR")
  status        InvoiceStatus @default(draft)
  issueDate     DateTime      @map("issue_date")
  dueDate       DateTime?     @map("due_date")
  paidDate      DateTime?     @map("paid_date")
  description   String?
  notes         String?
  pdfUrl        String?       @map("pdf_url")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  payment       Payment       @relation("PaymentInvoice", fields: [paymentId], references: [id], onDelete: Cascade)
  user          User          @relation("UserInvoices", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([issueDate])
  @@map("invoices")
}

model AgentSubscription {
  id                   String             @id @default(uuid())
  userId               String             @unique @map("user_id")
  plan                 SubscriptionPlan
  status               SubscriptionStatus
  amount               Decimal            @db.Decimal(12, 2)
  currency             String             @default("PKR")
  billingCycle         String             @default("monthly") @map("billing_cycle")
  stripeSubscriptionId String?            @map("stripe_subscription_id")
  stripeCustomerId     String?            @map("stripe_customer_id")
  listingLimit         Int?               @map("listing_limit")
  featuredSlots        Int                @default(0) @map("featured_slots")
