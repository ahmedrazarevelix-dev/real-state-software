// ═══════════════════════════════════════════════════════════════════════════
//  TENANT APPLICATION SYSTEM
// ═══════════════════════════════════════════════════════════════════════════

model TenantApplication {
  id                    String                    @id @default(uuid())
  applicantId           String                    @map("applicant_id")
  listingId             String                    @map("listing_id")
  
  // Personal Info
  fullName              String                    @map("full_name")
  phone                 String
  email                 String
  cnic                  String?                   // National ID
  
  // Employment Info
  employmentStatus      EmploymentStatus          @map("employment_status")
  employerName          String?                   @map("employer_name")
  monthlyIncome         Decimal?                  @db.Decimal(12, 2) @map("monthly_income")
  jobTitle              String?                   @map("job_title")
  
  // Rental Info
  moveInDate            DateTime                  @map("move_in_date")
  leaseDuration         Int?                      @map("lease_duration") // months
  numberOfOccupants     Int                       @default(1) @map("number_of_occupants")
  hasPets               Boolean                   @default(false) @map("has_pets")
  petDetails            String?                   @map("pet_details")
  
  // References
  emergencyContact      String?                   @map("emergency_contact")
  emergencyPhone        String?                   @map("emergency_phone")
  previousLandlord      String?                   @map("previous_landlord")
  previousLandlordPhone String?                   @map("previous_landlord_phone")
  
  // Application Status
  status                TenantApplicationStatus   @default(submitted)
  adminNotes            String?                   @map("admin_notes")
  rejectionReason       String?                   @map("rejection_reason")
  reviewedBy            String?                   @map("reviewed_by")
  reviewedAt            DateTime?                 @map("reviewed_at")
  
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")
  
  // Relations
  applicant             User                      @relation("TenantApplications", fields: [applicantId], references: [id], onDelete: Cascade)
  listing               PropertyListing           @relation("ListingApplications", fields: [listingId], references: [id], onDelete: Cascade)
  reviewer              User?                     @relation("ApplicationReviewer", fields: [reviewedBy], references: [id])
  documents             TenantApplicationDocument[]
  tenantAssignment      TenantAssignment?
  
  @@index([applicantId])
  @@index([listingId])
  @@index([status])
  @@map("tenant_applications")
}

model TenantApplicationDocument {
  id                  String                     @id @default(uuid())
  applicationId       String                     @map("application_id")
  documentType        TenantDocumentType         @map("document_type")
  fileName            String                     @map("file_name")
  storageKey          String                     @map("storage_key")
  mimeType            String                     @map("mime_type")
  fileSize            Int                        @map("file_size")
  status              VerificationDocumentStatus @default(pending)
  rejectionReason     String?                    @map("rejection_reason")
  uploadedAt          DateTime                   @default(now()) @map("uploaded_at")
  
  application         TenantApplication          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  @@unique([applicationId, documentType])
  @@map("tenant_application_documents")
}

model TenantAssignment {
  id                  String                  @id @default(uuid())
  applicationId       String                  @unique @map("application_id")
  tenantId            String                  @map("tenant_id")
  listingId           String                  @map("listing_id")
  
  // Lease Details
  leaseStartDate      DateTime                @map("lease_start_date")
  leaseEndDate        DateTime                @map("lease_end_date")
  monthlyRent         Decimal                 @db.Decimal(12, 2) @map("monthly_rent")
  securityDeposit     Decimal?                @db.Decimal(12, 2) @map("security_deposit")
  
  // Status
  status              TenantAssignmentStatus  @default(active)
  assignedBy          String                  @map("assigned_by")
  assignedAt          DateTime                @default(now()) @map("assigned_at")
  terminatedAt        DateTime?               @map("terminated_at")
  terminationReason   String?                 @map("termination_reason")
  
  // Relations
  application         TenantApplication       @relation(fields: [applicationId], references: [id])
  tenant              User                    @relation("TenantLeases", fields: [tenantId], references: [id], onDelete: Cascade)
  listing             PropertyListing         @relation("PropertyTenants", fields: [listingId], references: [id])
  assignedByUser      User                    @relation("AssignedTenants", fields: [assignedBy], references: [id])
  
  @@index([tenantId])
  @@index([listingId])
  @@index([status])
  @@map("tenant_assignments")
}

