//  PURCHASE/SALE AGREEMENT SYSTEM
// ═══════════════════════════════════════════════════════════════════════════

model PurchaseApplication {
  id                    String                      @id @default(uuid())
  applicantId           String                      @map("applicant_id")
  listingId             String                      @map("listing_id")
  
  // Personal Info
  fullName              String                      @map("full_name")
  phone                 String
  email                 String
  cnic                  String?
  
  // Financial Info
  offerPrice            Decimal                     @db.Decimal(14, 2) @map("offer_price")
  downPayment           Decimal                     @db.Decimal(14, 2) @map("down_payment")
  financingType         FinancingType               @map("financing_type")
  bankName              String?                     @map("bank_name")
  
  // Payment Plan
  paymentPlanType       PaymentPlanType             @map("payment_plan_type")
  installmentMonths     Int?                        @map("installment_months")
  monthlyInstallment    Decimal?                    @db.Decimal(12, 2) @map("monthly_installment")
  
  // Purpose & Background
  purchasePurpose       PurchasePurpose             @map("purchase_purpose")
  isFirstTimeBuyer      Boolean                     @default(false) @map("is_first_time_buyer")
  currentAddress        String?                     @map("current_address")
  occupation            String?
  employerName          String?                     @map("employer_name")
  monthlyIncome         Decimal?                    @db.Decimal(12, 2) @map("monthly_income")
  
  // References
  reference1Name        String?                     @map("reference1_name")
  reference1Phone       String?                     @map("reference1_phone")
  reference2Name        String?                     @map("reference2_name")
  reference2Phone       String?                     @map("reference2_phone")
  
  // Application Status
  status                PurchaseApplicationStatus   @default(submitted)
  adminNotes            String?                     @map("admin_notes")
  rejectionReason       String?                     @map("rejection_reason")
  reviewedBy            String?                     @map("reviewed_by")
  reviewedAt            DateTime?                   @map("reviewed_at")
  
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")
  
  // Relations
  applicant             User                        @relation("PurchaseApplications", fields: [applicantId], references: [id], onDelete: Cascade)
  listing               PropertyListing             @relation("ListingPurchaseApplications", fields: [listingId], references: [id], onDelete: Cascade)
  reviewer              User?                       @relation("PurchaseApplicationReviewer", fields: [reviewedBy], references: [id])
  documents             PurchaseApplicationDocument[]
  purchaseAgreement     PurchaseAgreement?
  
  @@index([applicantId])
  @@index([listingId])
  @@index([status])
  @@map("purchase_applications")
}

model PurchaseApplicationDocument {
  id                  String                     @id @default(uuid())
  applicationId       String                     @map("application_id")
  documentType        PurchaseDocumentType       @map("document_type")
  fileName            String                     @map("file_name")
  storageKey          String                     @map("storage_key")
  mimeType            String                     @map("mime_type")
  fileSize            Int                        @map("file_size")
  status              VerificationDocumentStatus @default(pending)
  rejectionReason     String?                    @map("rejection_reason")
  uploadedAt          DateTime                   @default(now()) @map("uploaded_at")
  
  application         PurchaseApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  @@unique([applicationId, documentType])
  @@map("purchase_application_documents")
}

model PurchaseAgreement {
  id                    String                    @id @default(uuid())
  applicationId         String                    @unique @map("application_id")
  buyerId               String                    @map("buyer_id")
  sellerId              String                    @map("seller_id")
  listingId             String                    @map("listing_id")
  
  // Agreement Details
  agreementNumber       String                    @unique @map("agreement_number")
  agreedPrice           Decimal                   @db.Decimal(14, 2) @map("agreed_price")
  downPaymentAmount     Decimal                   @db.Decimal(14, 2) @map("down_payment_amount")
  downPaymentDate       DateTime?                 @map("down_payment_date")
  
  // Payment Schedule
  paymentPlan           PaymentPlanType           @map("payment_plan")
  totalInstallments     Int?                      @map("total_installments")
  installmentAmount     Decimal?                  @db.Decimal(12, 2) @map("installment_amount")
  installmentStartDate  DateTime?                 @map("installment_start_date")
  finalPaymentDate      DateTime?                 @map("final_payment_date")
  
  // Dates
  agreementDate         DateTime                  @map("agreement_date")
  possessionDate        DateTime?                 @map("possession_date")
  registrationDate      DateTime?                 @map("registration_date")
  
  // Status
  status                PurchaseAgreementStatus   @default(active)
  paidAmount            Decimal                   @default(0) @db.Decimal(14, 2) @map("paid_amount")
  remainingAmount       Decimal                   @db.Decimal(14, 2) @map("remaining_amount")
  
  // Additional Terms
  terms                 String?
  specialConditions     String?                   @map("special_conditions")
  
  // Admin
  createdBy             String                    @map("created_by")
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")
  completedAt           DateTime?                 @map("completed_at")
  cancelledAt           DateTime?                 @map("cancelled_at")
  cancellationReason    String?                   @map("cancellation_reason")
  
  // Relations
  application           PurchaseApplication       @relation(fields: [applicationId], references: [id])
  buyer                 User                      @relation("BuyerAgreements", fields: [buyerId], references: [id], onDelete: Cascade)
  seller                User                      @relation("SellerAgreements", fields: [sellerId], references: [id])
  listing               PropertyListing           @relation("PropertyPurchaseAgreements", fields: [listingId], references: [id])
  creator               User                      @relation("CreatedAgreements", fields: [createdBy], references: [id])
  installments          InstallmentPayment[]
  
  @@index([buyerId])
  @@index([sellerId])
  @@index([listingId])
  @@index([status])
  @@map("purchase_agreements")
}

model InstallmentPayment {
  id                  String                @id @default(uuid())
  agreementId         String                @map("agreement_id")
  installmentNumber   Int                   @map("installment_number")
  dueDate             DateTime              @map("due_date")
  amount              Decimal               @db.Decimal(12, 2)
  paidAmount          Decimal               @default(0) @db.Decimal(12, 2) @map("paid_amount")
  status              InstallmentStatus     @default(pending)
  paidDate            DateTime?             @map("paid_date")
  paymentMethod       String?               @map("payment_method")
  transactionId       String?               @map("transaction_id")
  receiptUrl          String?               @map("receipt_url")
  notes               String?
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  
  agreement           PurchaseAgreement     @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  
  @@unique([agreementId, installmentNumber])
  @@index([agreementId, status])
  @@index([dueDate])
  @@map("installment_payments")
}

