model AgentSellerAgreement {
  id                 String                     @id @default(uuid())
  sellerId           String                     @map("seller_id")
  agentId            String                     @map("agent_id")
  listingId          String?                    @map("listing_id")
  commissionRate     Decimal                    @db.Decimal(5, 2) @map("commission_rate")
  commissionAmount   Decimal?                   @db.Decimal(12, 2) @map("commission_amount")
  status             AgentAgreementStatus       @default(pending)
  agreementType      AgentAgreementType         @default(exclusive) @map("agreement_type")
  startDate          DateTime                   @map("start_date")
  endDate            DateTime?                  @map("end_date")
  terms              String?                    // Agreement terms
  sellerSignedAt     DateTime?                  @map("seller_signed_at")
  agentSignedAt      DateTime?                  @map("agent_signed_at")
  cancelledAt        DateTime?                  @map("cancelled_at")
  cancellationReason String?                    @map("cancellation_reason")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  
  seller             User                       @relation("SellerAgreements", fields: [sellerId], references: [id], onDelete: Cascade)
  agent              User                       @relation("AgentAgreements", fields: [agentId], references: [id], onDelete: Cascade)
  listing            PropertyListing?           @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([sellerId])
  @@index([agentId])
  @@index([listingId])
  @@index([status])
  @@map("agent_seller_agreements")
}

